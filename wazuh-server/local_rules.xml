<group name="soc_custom,windows,attack,web,">

  <!-- ========================================== -->
  <!-- WINDOWS ENDPOINT DETECTION (SYSMON)       -->
  <!-- ========================================== -->
  <rule id="100001" level="15">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <description>CRITICAL: LSASS access - Possible credential dumping</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_access,</group>
  </rule>

  <rule id="100010" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell(\.exe)?$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(encodedcommand|bypass|hidden|invoke-expression|iex|downloadstring|webclient)</field>
    <description>Suspicious PowerShell execution: $(win.eventdata.commandLine)</description>
    <mitre><id>T1059.001</id></mitre>
    <group>execution,powershell,</group>
  </rule>

  <rule id="100030" level="15">
    <if_group>windows</if_group>
    <field name="win.system.eventID" type="pcre2">^(1102|104)$</field>
    <description>CRITICAL: Windows Event Log cleared</description>
    <mitre><id>T1070.001</id></mitre>
    <group>defense_evasion,</group>
  </rule>

  <rule id="100040" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(nc\.exe|ncat|netcat|-e cmd|-e powershell)</field>
    <description>Possible reverse shell detected: $(win.eventdata.commandLine)</description>
    <mitre><id>T1059</id></mitre>
    <group>command_and_control,</group>
  </rule>

  <rule id="100070" level="15" frequency="20" timeframe="30">
    <if_matched_group>syscheck</if_matched_group>
    <description>CRITICAL: Mass file changes - Possible ransomware</description>
    <mitre><id>T1486</id></mitre>
    <group>ransomware,</group>
  </rule>

  <!-- ========================================== -->
  <!-- DVWA WEB APPLICATION DETECTION            -->
  <!-- ========================================== -->
  <rule id="100201" level="10">
    <if_sid>31100</if_sid>
    <url>submit=Submit|login</url>
    <regex>(?i)union.*select|select.*from|drop.*table</regex>
    <description>DVWA: SQL Injection Attempt Detected</description>
    <mitre><id>T1190</id></mitre>
    <group>web,appsec,attack,</group>
  </rule>

  <rule id="100202" level="10" frequency="6" timeframe="30">
    <if_sid>31100</if_sid>
    <url>login\.php</url>
    <description>DVWA: Brute Force Attack Detected on Web Login Page</description>
    <mitre><id>T1110.001</id></mitre>
    <group>web,brute_force,attack,</group>
  </rule>

</group>
